8:["$","p",null,{"children":"We write each page for this guide in original language. Practical information is separated from promotional claims, and uncertainty is stated plainly. Because an app interface, bonus or rule may change, readers are asked to compare any general explanation with the latest terms shown by the relevant service."}]
9:["$","p",null,{"children":"We welcome corrections when a page is unclear or outdated. Useful feedback helps keep instructions precise, especially when a label, process or safety risk changes."}]
a:["$","div",null,{"className":"independence-note","children":[["$","strong",null,{"children":"Independent status"}],["$","p",null,{"children":"91 Guidebook is not the official website, operator or customer-care service of 91 Club. We do not open accounts, accept deposits, process withdrawals or guarantee outcomes."}]]}]
